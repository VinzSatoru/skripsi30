al="04A0" w:firstRow="1" w:lastRow="0" w:firstColumn="1" w:lastColumn="0" w:noHBand="0" w:noVBand="1"/></w:tblPr><w:tblGrid><w:gridCol w:w="1251"/><w:gridCol w:w="8099"/></w:tblGrid><w:tr w:rsidR="0098458E" w:rsidRPr="005B41B3" w14:paraId="51FAFF64" w14:textId="77777777" w:rsidTr="005B41B3"><w:trPr><w:trHeight w:val="811"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="669" w:type="pct"/></w:tcPr><w:p w14:paraId="7D2B131F" w14:textId="77777777" w:rsidR="0098458E" w:rsidRDefault="0098458E" w:rsidP="00F41CF5"><w:pPr><w:jc w:val="both"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>JUDUL</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4331" w:type="pct"/></w:tcPr><w:p w14:paraId="517DB294" w14:textId="695B7E93" w:rsidR="00093E77" w:rsidRPr="00093E77" w:rsidRDefault="00093E77" w:rsidP="00093E77"><w:pPr><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr><w:r w:rsidRPr="00093E77"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">Penerapan Metode XAI-SHAP pada Algoritma CatBoost untuk </w:t></w:r><w:r w:rsidR="00F91064"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>Klasifikasi</w:t></w:r><w:r w:rsidRPr="00093E77"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> Faktor Risiko Gangguan Tidur</w:t></w:r></w:p><w:p w14:paraId="4DD07A92" w14:textId="77777777" w:rsidR="0098458E" w:rsidRDefault="0098458E" w:rsidP="00F41CF5"><w:pPr><w:jc w:val="both"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr></w:p></w:tc></w:tr><w:tr w:rsidR="0098458E" w14:paraId="69EEDF7F" w14:textId="77777777" w:rsidTr="005B41B3"><w:trPr><w:trHeight w:val="1551"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="669" w:type="pct"/></w:tcPr><w:p w14:paraId="25247CB1" w14:textId="77777777" w:rsidR="0098458E" w:rsidRDefault="0098458E" w:rsidP="00F41CF5"><w:pPr><w:jc w:val="both"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Rumusan Malasah</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4331" w:type="pct"/></w:tcPr><w:p w14:paraId="4493C506" w14:textId="7644518A" w:rsidR="00644292" w:rsidRPr="00644292" w:rsidRDefault="00644292" w:rsidP="00644292"><w:pPr><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr><w:r w:rsidRPr="00644292"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">Bagaimana penerapan </w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>Shapley Additive exPlanations</w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> (SHAP) </w:t></w:r><w:r w:rsidR="0029498C"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">yang merupakan bagian dari </w:t></w:r><w:r w:rsidR="0029498C" w:rsidRPr="0029498C"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>Explainable AI</w:t></w:r><w:r w:rsidR="0029498C"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> (XAI) </w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>pada algoritma CatBoost dapat menghasilkan model klasifikasi risiko gangguan tidur yang transparan, sekaligus mampu mengidentifikasi faktor-faktor gaya hidup digital yang paling berkontribusi terhadap munculnya gangguan tersebut secara akurat dan dapat diinterpretasikan?</w:t></w:r></w:p><w:p w14:paraId="03D05238" w14:textId="181376D5" w:rsidR="0098458E" w:rsidRDefault="0098458E" w:rsidP="00F41CF5"><w:pPr><w:jc w:val="both"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr></w:p></w:tc></w:tr><w:tr w:rsidR="00F729A8" w14:paraId="0AAC85F1" w14:textId="77777777" w:rsidTr="005B41B3"><w:trPr><w:trHeight w:val="3109"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="669" w:type="pct"/></w:tcPr><w:p w14:paraId="0C00EAF9" w14:textId="77777777" w:rsidR="00F729A8" w:rsidRDefault="00F729A8" w:rsidP="00F41CF5"><w:pPr><w:jc w:val="both"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Latar Belakang</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4331" w:type="pct"/></w:tcPr><w:p w14:paraId="32E93F4E" w14:textId="0D60B800" w:rsidR="00644292" w:rsidRPr="00644292" w:rsidRDefault="00644292" w:rsidP="00792752"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="36" w:firstLine="770"/><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr><w:r w:rsidRPr="00644292"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>Gangguan tidur telah berkembang menjadi salah satu tantangan kesehatan global yang paling relevan di era modern. Kondisi ini dikaitkan dengan peningkatan risiko penyakit kronis</w:t></w:r><w:r><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>. M</w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>ulai dari gangguan kardiovaskular, diabetes tipe 2, hingga depresi klinis</w:t></w:r><w:r><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>yang pada akhirnya menekan produktivitas individu dan membebani sistem layanan kesehatan secara luas. Yang menarik, sebagian besar pemicunya bersifat perilaku dan terukur</w:t></w:r><w:r w:rsidR="00C04E29"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>, antara lain</w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> durasi paparan layar sebelum tidur, pola konsumsi kafein, intensitas tekanan kerja, hingga ritme aktivitas fisik harian. Studi yang melibatkan 20.645 mahasiswa di Provinsi Fujian membuktikan bahwa variabel-variabel gaya hidup ini adalah prediktor nyata yang dapat dipetakan secara kuantitatif menggunakan </w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>machine learning</w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> (Lin et al., 2025). Temuan tersebut membuka peluang konkret untuk membangun sistem deteksi dini berbasis data gaya hidup yang mampu mengklasifikasikan risiko gangguan tidur secara personal dan proaktif.</w:t></w:r></w:p><w:p w14:paraId="7571BDFC" w14:textId="77777777" w:rsidR="000217E8" w:rsidRPr="000217E8" w:rsidRDefault="000217E8" w:rsidP="00792752"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="36" w:firstLine="770"/><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3B390475" w14:textId="46EA9017" w:rsidR="00644292" w:rsidRPr="00644292" w:rsidRDefault="00644292" w:rsidP="00792752"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="36" w:firstLine="770"/><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr><w:r w:rsidRPr="00644292"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">Membangun sistem semacam itu menuntut algoritma yang tidak sekadar akurat, tetapi juga mampu menangani karakteristik data gaya hidup yang kaya akan dimensi heterogen, yaitu perpaduan antara variabel numerik seperti detak jantung dan BMI, dengan variabel kategorikal seperti jenis pekerjaan, kronotipen, dan kondisi kesehatan mental. Kehadiran fitur kategorikal dalam jumlah besar justru menjadi titik lemah banyak algoritma konvensional yang memerlukan </w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>encoding</w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> manual, prosedur yang rentan menimbulkan bias. CatBoost (</w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>Categorical Boosting</w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">) dirancang untuk mengatasi masalah ini dengan memproses fitur kategorikal secara langsung melalui mekanisme </w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>ordered target statistics</w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>. Keunggulan ini terbukti nyata</w:t></w:r><w:r w:rsidR="005267C7"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>;</w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> Taher &amp; Ayon (2024) melaporkan akurasi 93,80% pada pendekatan </w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>gradient boosting</w:t></w:r><w:r w:rsidRPr="00644292"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> untuk klasifikasi gangguan tidur, melampaui Random Forest dan AdaBoost. CatBoost dipilih bukan semata karena performanya, melainkan karena kesesuaiannya yang organik dengan struktur data gaya hidup yang kompleks.</w:t></w:r></w:p><w:p w14:paraId="332A0420" w14:textId="77777777" w:rsidR="000217E8" w:rsidRPr="000217E8" w:rsidRDefault="000217E8" w:rsidP="00792752"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="36" w:firstLine="770"/><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr></w:p><w:p w14:paraId="52465710" w14:textId="6165A9B9" w:rsidR="00792752" w:rsidRPr="00792752" w:rsidRDefault="00792752" w:rsidP="00792752"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="36" w:firstLine="770"/><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr><w:r><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>N</w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">amun, akurasi prediksi yang tinggi saja tidak cukup untuk menjadikan sebuah model layak digunakan dalam pengambilan keputusan medis. Inilah paradoks terbesar </w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>machine learning</w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> modern; semakin kompleks model, semakin sulit prediksinya untuk dipahami manusia. CatBoost, seperti algoritma </w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>ensemble</w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> berbasis pohon lainnya, beroperasi sebagai </w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>black-box</w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> yang menghasilkan keputusan dari ratusan pohon yang bekerja paralel tanpa menjelaskan mengapa seseorang dikategorikan berisiko tinggi. Kondisi ini bukan sekadar masalah teknis; ia menyentuh dimensi etika dan kepercayaan yang fundamental dalam penerapan AI di dunia kesehatan. Ha et al. (2023) menunjukkan bahwa penggunaan metode </w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>Explainable AI</w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> berbasis SHAP pada algoritma XGBoost mampu meningkatkan interpretabilitas prediksi gangguan tidur, meskipun penerapannya masih terbatas pada seleksi fitur kuesioner klinis, bukan penjelasan prediksi gaya hidup per individu secara </w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>real-time</w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">. Atas dasar itulah, </w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>Explainable AI</w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> (XAI) diposisikan sebagai komponen inti dalam penelitian ini.</w:t></w:r></w:p><w:p w14:paraId="396FF900" w14:textId="77777777" w:rsidR="000217E8" w:rsidRPr="000217E8" w:rsidRDefault="000217E8" w:rsidP="00792752"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="36" w:firstLine="770"/><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr></w:p><w:p w14:paraId="33D73489" w14:textId="3D80288D" w:rsidR="00980776" w:rsidRPr="00980776" w:rsidRDefault="00980776" w:rsidP="00792752"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="36" w:firstLine="770"/><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr><w:r w:rsidRPr="00980776"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">Perkembangan XAI dalam satu dekade terakhir telah melahirkan metode-metode yang mampu membuka selubung </w:t></w:r><w:r w:rsidRPr="00980776"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>black box</w:t></w:r><w:r w:rsidRPr="00980776"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> dan mengubah output model menjadi penjelasan yang bermakna bagi </w:t></w:r><w:r w:rsidR="00B456DA"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>tenaga kesehatan</w:t></w:r><w:r w:rsidRPr="00980776"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>. Alih-alih sekadar memberikan hasil prediksi, XAI memetakan kontribusi nyata setiap variabel input terhadap keputusan yang dihasilkan</w:t></w:r><w:r w:rsidR="00B456DA"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00980776"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">memungkinkan tenaga kesehatan memahami bukan hanya </w:t></w:r><w:r w:rsidRPr="00980776"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>apa</w:t></w:r><w:r w:rsidRPr="00980776"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> yang diprediksi, tetapi </w:t></w:r><w:r w:rsidRPr="00980776"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>mengapa</w:t></w:r><w:r w:rsidRPr="00980776"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> prediksi itu terbentuk. Keberhasilan pendekatan ini telah dibuktikan secara konkret oleh Emhandyksa &amp; Afifah (2026), yang menggunakan XAI berbasis </w:t></w:r><w:r w:rsidRPr="00980776"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>feature importance</w:t></w:r><w:r w:rsidRPr="00980776"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> untuk membangun peta risiko penyakit jantung yang dapat dibaca langsung oleh </w:t></w:r><w:r w:rsidR="00B456DA"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>tenaga kesehatan</w:t></w:r><w:r w:rsidRPr="00980776"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> tanpa latar belakang teknis dalam </w:t></w:r><w:r w:rsidRPr="00980776"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>machine learning</w:t></w:r><w:r w:rsidRPr="00980776"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>. Preseden dari domain kardiovaskular ini secara logis menunjuk peluang yang setara di domain gangguan tidur, mengingat variabilitas dan kompleksitas faktor gaya hidup yang jauh lebih kaya dan multidimensional di dalamnya.</w:t></w:r></w:p><w:p w14:paraId="62B9152C" w14:textId="77777777" w:rsidR="000217E8" w:rsidRPr="000217E8" w:rsidRDefault="000217E8" w:rsidP="00792752"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="36" w:firstLine="770"/><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7E2AFF34" w14:textId="4F8F7032" w:rsidR="00792752" w:rsidRPr="00FA390D" w:rsidRDefault="00792752" w:rsidP="00792752"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="36" w:firstLine="770"/><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">Meskipun penelitian-penelitian terdahulu telah memberikan kontribusi signifikan, terdapat lima celah riset yang belum terisi secara simultan. Taher &amp; Ayon (2024) dan Lin et al. (2025) membuktikan efektivitas </w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>machine learning</w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> untuk klasifikasi gangguan tidur, namun model yang dihasilkan masih bersifat </w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>black-box</w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> tanpa penjelasan faktor risiko spesifik per individu. Ha et al. (2023) telah menggabungkan XGBoost dan SHAP di domain tidur, namun menggunakan algoritma yang memerlukan </w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>encoding</w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> manual, fitur kuesioner klinis yang tidak </w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>modifiable</w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>, dan SHAP hanya untuk seleksi fitur. Srinivasu et al. (2024) memvalidasi keunggulan CatBoost-SHAP, namun pada domain kanker payudara dengan fitur laboratorium yang tidak dapat diubah pasien. Sementara itu, Emhandyksa &amp; Afifah (2026) mengalami kegagalan teknis saat mengimplementasikan SHAP. Dengan demikian</w:t></w:r><w:r w:rsidRPr="00FA390D"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>, belum ada penelitian yang mengintegrasikan CatBoost dengan SHAP untuk menganalisis faktor risiko gangguan tidur berbasis metrik gaya hidup secara individual (per-pasien) dan interaktif.</w:t></w:r></w:p><w:p w14:paraId="521AF87E" w14:textId="77777777" w:rsidR="00606805" w:rsidRDefault="00606805" w:rsidP="00792752"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="36" w:firstLine="770"/><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4B97F549" w14:textId="7EBA5747" w:rsidR="00792752" w:rsidRPr="00792752" w:rsidRDefault="00792752" w:rsidP="00792752"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="36" w:firstLine="770"/><w:jc w:val="both"/><w:rPr><w:b/><w:bCs/><w:lang w:val="en-ID"/></w:rPr></w:pPr><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">Berdasarkan celah riset yang telah diidentifikasi, penelitian ini bertujuan untuk menerapkan metode </w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>Explainable AI</w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> berbasis SHAP pada algoritma CatBoost guna menghasilkan model klasifikasi risiko gangguan tidur yang tidak hanya akurat, tetapi juga transparan dan dapat diinterpretasikan secara menyeluruh. Lundberg &amp; Lee (2017) menyatakan bahwa SHAP merupakan satu-satunya metode interpretabilitas yang secara matematis menjamin tiga properti fundamental: konsistensi lokal, </w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>missingness</w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">, dan akurasi aditif, menjadikannya fondasi yang ideal untuk mengurai kontribusi setiap fitur gaya hidup secara adil dan terukur. Melalui pendekatan ini, penelitian diharapkan mampu </w:t></w:r><w:r w:rsidRPr="00FA390D"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>mengidentifikasi faktor gaya hidup dominan yang berkontribusi terhadap risiko gangguan tidur secara individual untuk setiap pasien, sekaligus menghasilkan sistem pendukung keputusan berbasis web yang interaktif (mudah digunakan) dan siap diadaptasi dengan data rekam medis klinis lokal di masa mendatang</w:t></w:r><w:r w:rsidRPr="00792752"><w:rPr><w:b/><w:bCs/><w:lang w:val="en-ID"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="02AC5BE9" w14:textId="77777777" w:rsidR="00606805" w:rsidRPr="00606805" w:rsidRDefault="00606805" w:rsidP="00792752"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="36" w:firstLine="770"/><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr></w:p><w:p w14:paraId="78CDCFDF" w14:textId="5493D3A2" w:rsidR="00A5480D" w:rsidRPr="00F41CF5" w:rsidRDefault="00A5480D" w:rsidP="00792752"><w:pPr><w:pStyle w:val="ListParagraph"/><w:ind w:left="36" w:firstLine="770"/><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr></w:p></w:tc></w:tr><w:tr w:rsidR="0098458E" w14:paraId="5075693D" w14:textId="77777777" w:rsidTr="005B41B3"><w:tc><w:tcPr><w:tcW w:w="669" w:type="pct"/></w:tcPr><w:p w14:paraId="179B1FA2" w14:textId="5B7F87A1" w:rsidR="0098458E" w:rsidRDefault="0098458E" w:rsidP="00F41CF5"><w:pPr><w:jc w:val="both"/><w:rPr><w:lang w:val="en-US"/></w:rPr></w:pPr><w:r><w:rPr><w:lang w:val="en-US"/></w:rPr><w:lastRenderedPageBreak/><w:t>Tinjauan Pustaka</w:t></w:r><w:r w:rsidR="00792752"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve"> (</w:t></w:r><w:r w:rsidR="00E80FE4"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>S</w:t></w:r><w:r w:rsidR="00792752"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve">tate </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00792752"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>Of</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00792752"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00792752"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t>The</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00792752"><w:rPr><w:lang w:val="en-US"/></w:rPr><w:t xml:space="preserve"> Art)</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4331" w:type="pct"/></w:tcPr><w:p w14:paraId="365F0B73" w14:textId="77777777" w:rsidR="00A4222C" w:rsidRPr="00F1310B" w:rsidRDefault="00A4222C" w:rsidP="008626FC"><w:pPr><w:pStyle w:val="ListParagraph"/><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr></w:p><w:p w14:paraId="774717AF" w14:textId="4A078C5D" w:rsidR="00A4222C" w:rsidRDefault="00A4222C" w:rsidP="008626FC"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:jc w:val="both"/><w:rPr><w:b/><w:bCs/><w:lang w:val="en-ID"/></w:rPr></w:pPr><w:r w:rsidRPr="008626FC"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">Emhandyksa &amp; Afifah (2026) meneliti pengaruh variasi jumlah </w:t></w:r><w:r w:rsidRPr="008626FC"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>hidden layer</w:t></w:r><w:r w:rsidRPr="008626FC"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> dan </w:t></w:r><w:r w:rsidRPr="008626FC"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>neuron</w:t></w:r><w:r w:rsidRPr="008626FC"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> pada model </w:t></w:r><w:r w:rsidRPr="008626FC"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>Deep Learning Neural Network</w:t></w:r><w:r w:rsidRPr="008626FC"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> terhadap performa ekstraksi fitur metode LIME dan SHAP untuk penyakit jantung, namun </w:t></w:r><w:r w:rsidRPr="00FA390D"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>celah riset utama yang ditemukan adalah proses implementasi metode SHAP pada data riwayat kesehatan tersebut mengalami kegagalan teknis yang fatal yang disebabkan model SHAP tidak dapat mengolah data yang memiliki skala 0 hingga 1</w:t></w:r><w:r w:rsidRPr="00FA390D"><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidRPr="00FA390D"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> pada akhirnya membuktikan tingginya kompleksitas serta mutlaknya kebutuhan rekayasa arsitektur data spesifik.</w:t></w:r></w:p><w:p w14:paraId="70DA5994" w14:textId="77777777" w:rsidR="00A4222C" w:rsidRPr="008626FC" w:rsidRDefault="00A4222C" w:rsidP="00A4222C"><w:pPr><w:pStyle w:val="ListParagraph"/><w:jc w:val="both"/><w:rPr><w:b/><w:bCs/><w:lang w:val="en-ID"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7D649DC4" w14:textId="77777777" w:rsidR="00A4222C" w:rsidRPr="00FA390D" w:rsidRDefault="00A4222C" w:rsidP="00F1310B"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr><w:r w:rsidRPr="00F1310B"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">Ha et al. (2023) meneliti prediksi risiko gangguan tidur klinis menggunakan algoritma XGBoost dan metode SHAP berbasis data kuesioner medis, namun celah yang ditemukan adalah </w:t></w:r><w:r w:rsidRPr="00FA390D"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">model tersebut memerlukan </w:t></w:r><w:r w:rsidRPr="00FA390D"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">tahapan </w:t></w:r><w:r w:rsidRPr="00FA390D"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>encoding</w:t></w:r><w:r w:rsidRPr="00FA390D"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> manual yang rentan terhadap bias ordinal, masih sangat bergantung pada data kuesioner medis statis, serta hanya memanfaatkan metode SHAP sebatas untuk tahapan seleksi fitur di awal alih-alih digunakan untuk memberikan penjelasan prediksi interaktif secara </w:t></w:r><w:r w:rsidRPr="00FA390D"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>real-time</w:t></w:r><w:r w:rsidRPr="00FA390D"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="626DDCA3" w14:textId="77777777" w:rsidR="00A4222C" w:rsidRPr="00F1310B" w:rsidRDefault="00A4222C" w:rsidP="00A4222C"><w:pPr><w:pStyle w:val="ListParagraph"/><w:jc w:val="both"/><w:rPr><w:b/><w:bCs/><w:lang w:val="en-ID"/></w:rPr></w:pPr></w:p><w:p w14:paraId="18055886" w14:textId="77777777" w:rsidR="00A4222C" w:rsidRPr="00FA390D" w:rsidRDefault="00A4222C" w:rsidP="00F1310B"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr><w:r w:rsidRPr="00F1310B"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">Lin et al. (2025) meneliti faktor-faktor eksternal yang memengaruhi kualitas tidur menggunakan berbagai pemodelan </w:t></w:r><w:r w:rsidRPr="00F1310B"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>machine learning</w:t></w:r><w:r w:rsidRPr="00F1310B"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> prediktif berbasis kuesioner pada skala yang sangat besar, namun </w:t></w:r><w:r w:rsidRPr="00FA390D"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>celah riset yang ditemukan adalah analisis prediksi tersebut hanya relevan pada kesimpulan tingkat populasi umum secara agregat dan belum mampu memberikan penjelasan secara personal untuk masing-masing individu dengan kombinasi risiko gaya hidup yang sangat unik dan berbeda-beda.</w:t></w:r></w:p><w:p w14:paraId="64309076" w14:textId="77777777" w:rsidR="00A4222C" w:rsidRDefault="00A4222C" w:rsidP="00A4222C"><w:pPr><w:pStyle w:val="ListParagraph"/><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2021CAF3" w14:textId="77777777" w:rsidR="00A4222C" w:rsidRPr="00FA390D" w:rsidRDefault="00A4222C" w:rsidP="008626FC"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr><w:r w:rsidRPr="008626FC"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">Srinivasu et al. (2024) meneliti pemodelan akurasi diagnosis medis penyakit kanker menggunakan kombinasi arsitektur unggul algoritma </w:t></w:r><w:r w:rsidRPr="008626FC"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>CatBoost</w:t></w:r><w:r w:rsidRPr="008626FC"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> dan metode </w:t></w:r><w:r w:rsidRPr="008626FC"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>SHAP</w:t></w:r><w:r w:rsidRPr="008626FC"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">, namun </w:t></w:r><w:r w:rsidRPr="00FA390D"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>celah krusial yang ditemukan adalah efektivitas kombinasi canggih tersebut baru berhasil tervalidasi pada parameter data laboratorium medis yang karakternya sangat statis, dan sama sekali belum pernah diuji pada metrik gaya hidup yang karakternya fleksibel di mana penjelasan XAI dapat langsung diadaptasi menjadi rekomendasi perubahan perilaku harian.</w:t></w:r></w:p><w:p w14:paraId="5CD3216D" w14:textId="77777777" w:rsidR="00A4222C" w:rsidRPr="00A4222C" w:rsidRDefault="00A4222C" w:rsidP="00A4222C"><w:pPr><w:jc w:val="both"/><w:rPr><w:b/><w:bCs/><w:lang w:val="en-ID"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4B737D94" w14:textId="77777777" w:rsidR="00A4222C" w:rsidRPr="00FA390D" w:rsidRDefault="00A4222C" w:rsidP="00F1310B"><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:jc w:val="both"/><w:rPr><w:lang w:val="en-ID"/></w:rPr></w:pPr><w:r w:rsidRPr="00F1310B"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve">Taher &amp; Ayon (2024) meneliti klasifikasi gangguan tidur menggunakan algoritma </w:t></w:r><w:r w:rsidRPr="00F1310B"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>machine learning</w:t></w:r><w:r w:rsidRPr="00F1310B"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> konvensional seperti Gradient Boosting yang dioptimasi pada dataset kesehatan dan gaya hidup, namun celah yang ditemukan adalah model klasifikasi tersebut beroperasi sepenuhnya sebagai </w:t></w:r><w:r w:rsidRPr="00F1310B"><w:rPr><w:i/><w:iCs/><w:lang w:val="en-ID"/></w:rPr><w:t>black-box</w:t></w:r><w:r w:rsidRPr="00F1310B"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t xml:space="preserve"> yang </w:t></w:r><w:r w:rsidRPr="00FA390D"><w:rPr><w:lang w:val="en-ID"/></w:rPr><w:t>hanya mampu mendeteksi tingkat risiko secara global tanpa mampu menjelaskan faktor penyebab spesifik secara individual, sehingga tidak memberikan panduan intervensi klinis yang dapat langsung ditindaklanjuti oleh dokter maupun pasien.</w:t></w:r></w:p><w:p w14:paraId="57FAED7B" w14:textId="7E1869EA" w:rsidR="0098458E" w:rsidRPr="0098458E" w:rsidRDefault="0098458E" w:rsidP="00F41CF5"><w:pPr><w:jc w: